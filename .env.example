# TRON Network
TRON_FULL_NODE=https://api.trongrid.io
TRON_SOLIDITY_NODE=https://api.trongrid.io
TRON_EVENT_SERVER=https://api.trongrid.io

# Relayer Wallet (must have TRX balance for burning Energy per tx)
RELAYER_PRIVATE_KEY=your_relayer_private_key_here

# Server
PORT=3000
NODE_ENV=production

# Redis (for rate limiting — optional, falls back to memory)
REDIS_URL=redis://localhost:6379

# Security
API_KEY=your_secret_api_key_for_frontend

# Rate limiting
MAX_DAILY_RELAYS_PER_ADDRESS=10

# Relayer safety — stop accepting relays if balance drops below this (TRX)
MIN_RELAYER_BALANCE=20

# Health check alert threshold (TRX) — warns in /health but doesn't block
HEALTH_BALANCE_ALERT=100
